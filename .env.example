# Set these environment variables before starting app/app.py.
# This file is a reference; it is not loaded automatically.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
# Optional: omit to generate a persistent local key in instance/session.key
# FLASK_SECRET_KEY=replace-with-a-long-random-secret
# COOKIE_SECURE=1  # Enable when serving through HTTPS
# FLASK_DEBUG=1
